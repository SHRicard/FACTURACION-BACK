# ─── Servidor ────────────────────────────────────────────────
# Puerto donde escucha la API (opcional, por defecto 4000)
PORT=4000

# Entorno: development | production (opcional, por defecto development)
# En el hosting va production: activa los controles de arranque de abajo.
# El stack de los errores 500 solo viaja al cliente con NODE_ENV=development.
NODE_ENV=development

# Detalle de los logs: debug | info | warn | error | silent (opcional)
# Sin setear: "debug" en desarrollo, "info" con NODE_ENV=production.
# En producción no se deja en debug: loguea cada request.
# LOG_LEVEL=debug

# ─── Base de datos ───────────────────────────────────────────
# Cadena de conexión a MongoDB.
#   Local:  mongodb://127.0.0.1:27017/cuenta_corriente
#   Atlas:  mongodb+srv://usuario:password@cluster.mongodb.net/cuenta_corriente
MONGO_URI=mongodb://127.0.0.1:27017/cuenta_corriente

# ─── Autenticación ───────────────────────────────────────────
# Clave para firmar los tokens JWT. Poné algo largo y aleatorio.
# Generar una:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# En producción el server no arranca si es esta de ejemplo o si tiene menos
# de 32 caracteres: con una clave conocida cualquiera firma sesiones.
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria

# ─── Super admin inicial ─────────────────────────────────────
# Se crea automáticamente la primera vez que arranca el servidor.
# En producción SUPER_ADMIN_PASSWORD tiene que tener 12 caracteres o más y no
# ser la de ejemplo, o el server no arranca.
SUPER_ADMIN_EMAIL=admin@tuapp.com
SUPER_ADMIN_PASSWORD=cambiar123

# ─── Proxy ───────────────────────────────────────────────────
# Cuántos proxies hay delante del server, exacto: Render, Railway o Fly = 1;
# Cloudflare delante de otro de esos = 2. Nunca "true": con true cualquiera
# falsifica X-Forwarded-For y tiene un contador de rate limit nuevo en cada
# request. Mal puesto, req.ip es la del proxy y toda la app comparte un solo
# contador. Sin setear: 1 en producción y 0 en desarrollo.
# TRUST_PROXY=1

# ─── URL pública de esta API ─────────────────────────────────
# URL pública de ESTA API (no la del front). Es la base de todos los links
# que salen de acá, así que tiene que abrir desde el celular:
#   - el link de la factura que se le manda al cliente por WhatsApp,
#   - el de "recuperar contraseña" (<API_PUBLIC_URL>/cuenta/nueva-password),
#   - el de "abrir la app" de los mails (<API_PUBLIC_URL>/cuenta/abrir).
# Desarrollo con Expo en un celular: la IP de tu máquina en la red, por
# ejemplo http://192.168.0.10:4000. Sin setear usa http://localhost:<PORT>,
# que solo abre en esta máquina.
# En producción es obligatoria, https y sin localhost: si no, el server no
# arranca.
API_PUBLIC_URL=http://localhost:4000

# ─── App móvil ───────────────────────────────────────────────
# Scheme de la app: los botones "Abrir la app" de las páginas de /cuenta.
# APP_SCHEME=facturacionfront
#
# Ficha de la app en la tienda: el link de "Bajar la app" y el de "Actualizar".
# APP_URL_TIENDA=https://play.google.com/store/apps/details?id=io.rrdev.facturacion
#
# Versión mínima de la app (mayor.menor.parche). Ojo: subirla bloquea AL
# INSTANTE, con 426 APP_DESACTUALIZADA, a toda versión más vieja que mande el
# header X-App-Version. Se sube solo cuando un cambio del back rompe a las
# versiones viejas y la nueva ya está publicada en la tienda.
# APP_VERSION_MINIMA=0.0.0
#
# Última versión publicada (opcional). No bloquea: la app muestra un aviso de
# que hay una nueva.
# APP_VERSION_ULTIMA=

# ─── Documentos legales y Google Play ────────────────────────
# Nombre con el que la app aparece en la ficha de Play y en los documentos.
APP_NAME=Facturación FCT

# Correo REAL y atendido para privacidad, derechos y bajas de cuenta.
# Google Play lo revisa: sin esta variable los documentos salen con un
# contacto de ejemplo y un aviso visible, y la ficha se rechaza.
# Obligatorio en producción: sin él el server no arranca.
LEGAL_CONTACT_EMAIL=

# Las URLs que se declaran en Play Console salen de API_PUBLIC_URL (arriba),
# que en producción tiene que ser HTTPS:
#   <API_PUBLIC_URL>/legal/privacidad       → Política de privacidad
#   <API_PUBLIC_URL>/legal/terminos         → Términos y condiciones
#   <API_PUBLIC_URL>/legal/eliminar-cuenta  → Eliminación de cuenta y datos

# Clave para firmar esos links (opcional). Sin setear se deriva de JWT_SECRET:
# es distinta de la de las sesiones igual. Cambiarla invalida todos los links.
# ENLACES_SECRET=

# ─── Cloudinary: el logo de la marca de cada usuario ─────────
# La app sube el logo directo a Cloudinary con una firma que da el backend;
# el secreto nunca sale del server. Sin estas variables, subir un logo
# responde 503 y el PDF sale con el nombre de la marca, sin logo.
#
# Se sacan de la consola de Cloudinary (Dashboard → API Keys). Alcanza con
# CLOUDINARY_URL, o con las tres variables sueltas.
#
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─── Envío de mails ──────────────────────────────────────────
# En desarrollo son opcionales: sin estas variables los mails se imprimen en
# la consola en vez de enviarse, así se prueba todo sin configurar nada.
# En producción el SMTP es obligatorio (MAIL_HOST, MAIL_USER y MAIL_PASS):
# sin él no llega el link de recuperar contraseña y el server no arranca.
#
# Para producción conviene un proveedor transaccional con dominio propio y
# SPF, DKIM y DMARC configurados en el DNS: Resend, Postmark, Amazon SES o
# Brevo, todos por SMTP con estas mismas variables. Gmail, solo para
# desarrollo: tiene tope diario, puede suspender una cuenta que manda en
# nombre de terceros (las facturas de cada negocio) y por ahí salen también
# los mails de recuperar contraseña.
#
# Gmail / Google Workspace: hay que usar una "contraseña de aplicación"
# (myaccount.google.com → Seguridad → Contraseñas de aplicaciones), no la
# contraseña de la cuenta. Se puede pegar tal cual, con espacios.
#
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=tucuenta@gmail.com
# MAIL_PASS="xxxx xxxx xxxx xxxx"
# MAIL_FROM="Facturación FCT <tucuenta@gmail.com>"
#
# Opcionales:
# MAIL_SECURE=false                    # true solo en el puerto 465 (SSL directo)
# MAIL_TLS_REJECT_UNAUTHORIZED=true    # false solo contra un SMTP con cert propio
#
# Los nombres SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS también se aceptan.

# ─── Login con Google (opcional) ─────────────────────────────
# Sin estas variables el endpoint /auth/google responde 503 y el resto del
# login (email + contraseña) sigue funcionando igual.
#
# Los client ID se sacan de Google Cloud Console → APIs y servicios →
# Credenciales. Hace falta uno POR PLATAFORMA: el "aud" del token que manda el
# front es el de la plataforma desde la que se logueó, y el back los acepta a
# todos. Ver doc/GOOGLE_AUTH.md.
#
# GOOGLE_CLIENT_ID_WEB=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_ID_IOS=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_ID_ANDROID=xxxxx.apps.googleusercontent.com

# ─── Notificaciones push (avisos del super_admin) ────────────
# Se mandan por el servicio de Expo: el back no necesita claves de Firebase.
# Las credenciales de Google (FCM) y Apple (APNs) se cargan una vez en el
# proyecto de EAS con `eas credentials`. Ver doc/NOTIFICACIONES.md.
#
# Solo si en expo.dev → Project settings se activó "Enhanced security for push
# notifications": el access token de Expo. Sin eso, se deja vacío.
# EXPO_ACCESS_TOKEN=
