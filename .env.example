# ─── Servidor ────────────────────────────────────────────────
# Puerto donde escucha la API (opcional, por defecto 4000)
PORT=4000

# Entorno: development | production (opcional, por defecto development)
NODE_ENV=development

# Detalle de los logs: debug | info | warn | error | silent (opcional)
# Sin setear: "debug" en desarrollo, "info" con NODE_ENV=production.
LOG_LEVEL=debug

# ─── Base de datos ───────────────────────────────────────────
# Cadena de conexión a MongoDB.
#   Local:  mongodb://127.0.0.1:27017/cuenta_corriente
#   Atlas:  mongodb+srv://usuario:password@cluster.mongodb.net/cuenta_corriente
MONGO_URI=mongodb://127.0.0.1:27017/cuenta_corriente

# ─── Autenticación ───────────────────────────────────────────
# Clave para firmar los tokens JWT. Poné algo largo y aleatorio.
# Generar una:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria

# ─── Super admin inicial ─────────────────────────────────────
# Se crea automáticamente la primera vez que arranca el servidor.
SUPER_ADMIN_EMAIL=admin@tuapp.com
SUPER_ADMIN_PASSWORD=cambiar123

# ─── Frontend ────────────────────────────────────────────────
# Base del link que se manda por mail para recuperar la contraseña.
# Queda como: <FRONTEND_URL>/resetear-password?token=xxx
FRONTEND_URL=http://localhost:5173

# ─── Envío de mails (opcional) ───────────────────────────────
# Sin estas variables el sistema anda igual: los mails se imprimen en la
# consola en vez de enviarse. Útil para desarrollar sin configurar nada.
#
# Gmail / Google Workspace: hay que usar una "contraseña de aplicación"
# (myaccount.google.com → Seguridad → Contraseñas de aplicaciones), no la
# contraseña de la cuenta. Se puede pegar tal cual, con espacios.
#
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=tucuenta@gmail.com
# MAIL_PASS="xxxx xxxx xxxx xxxx"
# MAIL_FROM="Cuenta Corriente <tucuenta@gmail.com>"
#
# Opcionales:
# MAIL_SECURE=false                    # true solo en el puerto 465 (SSL directo)
# MAIL_TLS_REJECT_UNAUTHORIZED=true    # false solo contra un SMTP con cert propio
#
# Los nombres SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS también se aceptan.

# ─── Login con Google (opcional) ─────────────────────────────
# Sin estas variables el endpoint /auth/google responde 503 y el resto del
# login (email + contraseña) sigue funcionando igual.
#
# Los client ID se sacan de Google Cloud Console → APIs y servicios →
# Credenciales. Hace falta uno POR PLATAFORMA: el "aud" del token que manda el
# front es el de la plataforma desde la que se logueó, y el back los acepta a
# todos. Ver doc/GOOGLE_AUTH.md.
#
# GOOGLE_CLIENT_ID_WEB=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_ID_IOS=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_ID_ANDROID=xxxxx.apps.googleusercontent.com
